# ─── Build output (any build/ folder, at any depth) ───────────────
build/
Build/
out/
cmake-build-*/

# ─── CMake generated files ────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake.stamp
compile_commands.json

# ─── Secrets / config ─────────────────────────────────────────────
# Holds the Giphy API key — never commit it.
server_config.json

# ─── vcpkg ────────────────────────────────────────────────────────
# We use a system vcpkg (via VCPKG_ROOT), not an in-repo one.
vcpkg/
vcpkg_installed/
*.vcpkg

# ─── Qt / Qt Creator generated files ──────────────────────────────
*.pro.user*
CMakeLists.txt.user*
.qmake.cache
.qmake.stash
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qm
*_autogen/

# ─── Compiler / linker artifacts ──────────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.idb
*.exp
*.res

# ─── Editor / IDE config ──────────────────────────────────────────
.vscode/
.vs/
.idea/
*.swp
*~

# ─── OS junk ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Runtime / logs ───────────────────────────────────────────────
*.log
server.log
    
# ─── Miscellaneous ───────────────────────────────────────────────
*.claudeignore
